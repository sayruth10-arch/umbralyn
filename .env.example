# Ne jamais commiter de secrets. Copiez ce fichier vers .env uniquement

# si votre outil de lancement charge les variables d'environnement.

UMBRALYN_CONFIG=config.yaml

UMBRALYN_TARGET=
UMBRALYN_TIMEOUT=600
UMBRALYN_DATABASE_PATH=./data/umbralyn.db
UMBRALYN_REPORTS_DIR=./reports
UMBRALYN_ALERT_THRESHOLD=70

UMBRALYN_SERVICE_DETECTION=true
UMBRALYN_OS_DETECTION=false
UMBRALYN_NSE=false

# Clé API NVD facultative

# UMBRALYN_NVD_API_KEY=

# Identifiants SMTP facultatifs pour les alertes email

# UMBRALYN_SMTP_USER=

# UMBRALYN_SMTP_PASS=
